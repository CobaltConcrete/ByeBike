# Copy to .env and fill in after following docs/GCP_SETUP.md.
# Restart the app after edits. Nonempty values override saved UI settings.
BYEBIKE_GCS_ENABLED=
BYEBIKE_GCS_PROJECT=
BYEBIKE_GCS_BUCKET=
BYEBIKE_GCS_PREFIX=

# Optional absolute path to service-account JSON, stored outside this repo.
# Leave blank if using gcloud auth application-default login.
GOOGLE_APPLICATION_CREDENTIALS=

# Cloud Run: deploy-cloud-run.ps1 supplies settings and the password through Secret Manager.
# Leave these unset for normal local use.
# BYEBIKE_HOSTED=true
# BYEBIKE_APP_PASSWORD=<generated secret, at least 24 characters>
# BYEBIKE_DATA_DIR=/tmp/byebike
